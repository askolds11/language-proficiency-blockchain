  "components": {
    "schemas": {
      "AddInstitutionBlockRequest": {
        "required": [
          "blockId",
          "institutionId",
          "institutionName"
        ],
        "type": "object",
        "properties": {
          "blockId": {
            "type": "string",
            "description": "Id of the new block",
            "format": "uuid"
          },
          "institutionId": {
            "type": "string",
            "description": "Id of the institution",
            "format": "uuid"
          },
          "institutionName": {
            "type": "string",
            "description": "Name of the institution"
          }
        },
        "description": "Request for proposing a new institution block."
      },
      "AddInstitutionRequest": {
        "required": [
          "id",
          "name",
          "address",
          "publicKeyPem"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id of the institution",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "Name of the institution"
          },
          "address": {
            "type": "string",
            "description": "Address of the institution"
          },
          "publicKeyPem": {
            "type": "string",
            "description": "Public key of the institution"
          }
        },
        "description": "Request for adding an institution."
      },
      "AddStudentRequest": {
        "required": [
          "id",
          "name",
          "surname"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id of the student",
            "format": "uuid"
          },
          "name": {
            "type": [
              "null",
              "string"
            ],
            "description": "Name of the student"
          },
          "surname": {
            "type": [
              "null",
              "string"
            ],
            "description": "Surname of the student"
          }
        },
        "description": "Request for adding a student."
      },
      "AddTestBlockRequest": {
        "required": [
          "blockId",
          "testId",
          "institutionId",
          "maxScore",
          "name",
          "signatures"
        ],
        "type": "object",
        "properties": {
          "blockId": {
            "type": "string",
            "format": "uuid"
          },
          "testId": {
            "type": "string",
            "format": "uuid"
          },
          "institutionId": {
            "type": "string",
            "format": "uuid"
          },
          "maxScore": {
            "type": "string"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "signatures": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SignedByInstitution"
            }
          }
        }
      },
      "AddTestRequest": {
        "required": [
          "blockId",
          "testId",
          "institutionId",
          "maxScore",
          "name"
        ],
        "type": "object",
        "properties": {
          "blockId": {
            "type": "string",
            "description": "Id of the new block",
            "format": "uuid"
          },
          "testId": {
            "type": "string",
            "description": "Id of the test",
            "format": "uuid"
          },
          "institutionId": {
            "type": "string",
            "description": "Id of the institution",
            "format": "uuid"
          },
          "maxScore": {
            "type": "string",
            "description": "Maximum score for the test"
          },
          "name": {
            "type": [
              "null",
              "string"
            ],
            "description": "Name of the test"
          }
        },
        "description": "Request for proposing a new test block."
      },
      "AddTestResultBlockRequest": {
        "required": [
          "blockId",
          "testResultId",
          "testId",
          "studentId",
          "score",
          "timestamp",
          "signatures"
        ],
        "type": "object",
        "properties": {
          "blockId": {
            "type": "string",
            "format": "uuid"
          },
          "testResultId": {
            "type": "string",
            "format": "uuid"
          },
          "testId": {
            "type": "string",
            "format": "uuid"
          },
          "studentId": {
            "type": "string",
            "format": "uuid"
          },
          "score": {
            "$ref": "#/components/schemas/JsonDocument"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "signatures": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SignedByInstitution"
            }
          }
        }
      },
      "AddTestResultRequest": {
        "required": [
          "blockId",
          "testResultId",
          "testId",
          "studentId",
          "score",
          "timestamp"
        ],
        "type": "object",
        "properties": {
          "blockId": {
            "type": "string",
            "description": "Id of the new block",
            "format": "uuid"
          },
          "testResultId": {
            "type": "string",
            "description": "Id of the test result",
            "format": "uuid"
          },
          "testId": {
            "type": "string",
            "description": "Id of the test",
            "format": "uuid"
          },
          "studentId": {
            "type": "string",
            "description": "Id of the student",
            "format": "uuid"
          },
          "score": {
            "description": "Score as a JSON document",
            "$ref": "#/components/schemas/JsonDocument"
          },
          "timestamp": {
            "type": "string",
            "description": "Timestamp of the test result",
            "format": "date-time"
          }
        },
        "description": "Request for proposing a new test result block."
      },
      "AssignRoleRequest": {
        "required": [
          "userId",
          "role"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "description": "Id of the user",
            "format": "uuid"
          },
          "role": {
            "description": "Role to assign",
            "$ref": "#/components/schemas/UserRole"
          }
        },
        "description": "Request for assigning a role to a user."
      },
      "AuthenticationResponse": {
        "required": [
          "token",
          "userId",
          "email",
          "roles",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT token for authenticated requests."
          },
          "userId": {
            "type": "string",
            "description": "User identifier.",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "description": "User email address."
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserRole"
            },
            "description": "User roles."
          },
          "expiresAt": {
            "type": "string",
            "description": "Token expiration time in UTC.",
            "format": "date-time"
          }
        },
        "description": "Response model for successful authentication."
      },
      "BlockBase": {
        "type": "object",
        "properties": {
          "prevHash": {
            "type": "string",
            "format": "byte"
          },
          "version": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "BlockEntity": {
        "required": [
          "id",
          "type",
          "prevId",
          "prevHash",
          "hash",
          "institutionId",
          "signedHash",
          "timestamp"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier of the block.",
            "format": "uuid"
          },
          "type": {
            "description": "The semantic type of the block (e.g., BlockType.TestResult).",
            "$ref": "#/components/schemas/BlockType"
          },
          "prevId": {
            "type": "string",
            "description": "Identifier of the previous block",
            "format": "uuid"
          },
          "prevHash": {
            "type": "string",
            "description": "Hash of the previous block (hex-encoded). Empty for the genesis block.",
            "format": "byte"
          },
          "hash": {
            "type": "string",
            "description": "Hash of the current block (hex-encoded) calculated from the block contents.",
            "format": "byte"
          },
          "institutionId": {
            "type": [
              "null",
              "string"
            ],
            "description": "Identifier of the institution that created and signed the block.",
            "format": "uuid"
          },
          "signedHash": {
            "type": "string",
            "description": "Signed block hash signed by Guid? BlockEntity.InstitutionId's private key.",
            "format": "byte"
          },
          "timestamp": {
            "type": "string",
            "description": "UTC timestamp when the block was created.",
            "format": "date-time"
          },
          "prevBlock": {
            "description": "Navigation to the previous block entity.",
            "$ref": "#/components/schemas/BlockEntity"
          },
          "institution": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "Navigation to the related institution entity.",
                "$ref": "#/components/schemas/InstitutionEntity"
              }
            ]
          },
          "institutionData": {
            "description": "Navigation to the block's institution if relevant.",
            "$ref": "#/components/schemas/InstitutionEntity"
          },
          "testData": {
            "description": "Navigation to the block's test if relevant.",
            "$ref": "#/components/schemas/TestEntity"
          },
          "testResultData": {
            "description": "Navigation to the block's test result if relevant.",
            "$ref": "#/components/schemas/TestResultEntity"
          }
        },
        "description": "Represents a block in the blockchain containing immutable, signed data."
      },
      "BlockResponse": {
        "required": [
          "id",
          "type",
          "prevId",
          "prevHashHex",
          "hashHex",
          "institutionId",
          "signedHashHex",
          "timestamp"
        ],
        "type": "object",
        "properties": {
          "id": {
