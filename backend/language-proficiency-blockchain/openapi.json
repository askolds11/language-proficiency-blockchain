{
  "openapi": "3.1.1",
  "info": {
    "title": "language-proficiency-blockchain | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/example/{id}": {
      "get": {
        "tags": [
          "Example"
        ],
        "summary": "Example endpoint that returns an example",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Example's id",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns example if id &lt; 10",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExampleResponse"
                }
              }
            }
          },
          "404": {
            "description": "If id &gt;= 10"
          }
        }
      }
    },
    "/api/example": {
      "post": {
        "tags": [
          "Example"
        ],
        "summary": "Example endpoint that returns an example",
        "requestBody": {
          "description": "Example",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExampleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Returns example if id &lt; 10",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExampleResponse"
                }
              }
            }
          },
          "404": {
            "description": "If id &gt;= 10"
          }
        }
      }
    },
    "/api/internal/institution": {
      "post": {
        "tags": [
          "Internal"
        ],
        "summary": "Proposes a new node to join the network. The proposal must be signed by the node's key.",
        "requestBody": {
          "description": "Proposal payload including public key, address and signature.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddInstitutionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddInstitutionRequest": {
        "required": [
          "id",
          "name",
          "address",
          "publicKeyPem"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id of the institution",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "Name of the institution"
          },
          "address": {
            "type": "string",
            "description": "Address of the institution"
          },
          "publicKeyPem": {
            "type": "string",
            "description": "Public key of the institution"
          }
        },
        "description": "Request for adding an institution."
      },
      "ExampleRequest": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Id of the Example",
            "format": "int32"
          }
        },
        "description": "Example request",
        "example": {
          "id": 1
        }
      },
      "ExampleResponse": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Id of the Example",
            "format": "int32"
          },
          "name": {
            "type": "string",
            "description": "Name of the Example"
          }
        },
        "description": "Example response",
        "example": {
          "id": 1,
          "name": "1"
        }
      }
    }
  },
  "tags": [
    {
      "name": "Example"
    },
    {
      "name": "Internal"
    }
  ]
}